# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/

# ─── Environment variables ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
