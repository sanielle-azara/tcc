apps/backend/node_modules/.prisma/
# Migration backup files
prisma/migrations/*.sql.bak

# ─── Vite ────────────────────────────────────────────────────────────────────
apps/frontend/.vite/

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Editors ─────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

